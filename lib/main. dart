import 'package:flutter/material.dart';

void main() {
  runApp(const PRBusinessApp());
}

class PRBusinessApp extends StatelessWidget {
  const PRBusinessApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'PR Business',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        colorScheme: ColorScheme.fromSeed(
          seedColor: const Color(0xFF1565C0),
        ),
        useMaterial3: true,
      ),
      home: const HomePage(),
    );
  }
}

class HomePage extends StatefulWidget {
  const HomePage({super.key});

  @override
  State<HomePage> createState() => _HomePageState();
}

class _HomePageState extends State<HomePage> {
  int selectedIndex = 0;

  final List<String> titles = [
    'PR Business',
    'Documents',
    'Income & Expense',
    'Reports',
  ];

  @override
  Widget build(BuildContext context) {
    final pages = [
      dashboard(),
      documents(),
      accounts(),
      reports(),
    ];

    return Scaffold(
      appBar: AppBar(
        title: Text(titles[selectedIndex]),
        backgroundColor: const Color(0xFF1565C0),
        foregroundColor: Colors.white,
      ),
      body: pages[selectedIndex],
      bottomNavigationBar: NavigationBar(
        selectedIndex: selectedIndex,
        onDestinationSelected: (index) {
          setState(() => selectedIndex = index);
        },
        destinations: const [
          NavigationDestination(
            icon: Icon(Icons.dashboard_outlined),
            label: 'Home',
          ),
          NavigationDestination(
            icon: Icon(Icons.description_outlined),
            label: 'Documents',
          ),
          NavigationDestination(
            icon: Icon(Icons.account_balance_wallet_outlined),
            label: 'Accounts',
          ),
          NavigationDestination(
            icon: Icon(Icons.bar_chart),
            label: 'Reports',
          ),
        ],
      ),
    );
  }

  Widget dashboard() {
    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        const Text(
          'Welcome to PR Business',
          style: TextStyle(
            fontSize: 24,
            fontWeight: FontWeight.bold,
          ),
        ),
        const SizedBox(height: 6),
        const Text('Invoice & Accounts Management'),
        const SizedBox(height: 20),
        Row(
          children: [
            summaryCard('Income', '₹0', Icons.trending_up),
            const SizedBox(width: 12),
            summaryCard('Expense', '₹0', Icons.trending_down),
          ],
        ),
        const SizedBox(height: 12),
        Row(
          children: [
            summaryCard('Invoices', '0', Icons.receipt_long),
            const SizedBox(width: 12),
            summaryCard('Quotations', '0', Icons.request_quote),
          ],
        ),
        const SizedBox(height: 24),
        const Text(
          'Quick Actions',
          style: TextStyle(
            fontSize: 20,
            fontWeight: FontWeight.bold,
          ),
        ),
        const SizedBox(height: 12),
        actionButton('Create Invoice', Icons.receipt_long, 1),
        actionButton('Create Estimate', Icons.calculate_outlined, 1),
        actionButton('Create Quotation', Icons.request_quote, 1),
        actionButton('Income & Expense', Icons.wallet, 2),
        actionButton('View Reports', Icons.bar_chart, 3),
      ],
    );
  }

  Widget summaryCard(String title, String amount, IconData icon) {
    return Expanded(
      child: Card(
        child: Padding(
          padding: const EdgeInsets.all(16),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Icon(icon, color: const Color(0xFF1565C0), size: 28),
              const SizedBox(height: 12),
              Text(title),
              const SizedBox(height: 6),
              Text(
                amount,
                style: const TextStyle(
                  fontSize: 22,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget actionButton(String title, IconData icon, int page) {
    return Card(
      child: ListTile(
        leading: Icon(icon, color: const Color(0xFF1565C0)),
        title: Text(title),
        trailing: const Icon(Icons.arrow_forward_ios, size: 16),
        onTap: () => setState(() => selectedIndex = page),
      ),
    );
  }

  Widget documents() {
    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        const Text(
          'Documents',
          style: TextStyle(fontSize: 22, fontWeight: FontWeight.bold),
        ),
        const SizedBox(height: 12),
        documentButton('Invoice', Icons.receipt_long),
        documentButton('Estimate', Icons.calculate_outlined),
        documentButton('Quotation', Icons.request_quote),
        documentButton('Invoice History', Icons.history),
      ],
    );
  }

  Widget documentButton(String title, IconData icon) {
    return Card(
      child: ListTile(
        leading: Icon(icon),
        title: Text(title),
        subtitle: const Text('Ready to configure'),
        trailing: const Icon(Icons.chevron_right),
      ),
    );
  }

  Widget accounts() {
    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        const Text(
          'Income & Expense',
          style: TextStyle(fontSize: 22, fontWeight: FontWeight.bold),
        ),
        const SizedBox(height: 12),
        const Card(
          child: ListTile(
            leading: Icon(Icons.trending_up, color: Colors.green),
            title: Text('Income'),
            subtitle: Text('Income tracking will be added next'),
          ),
        ),
        const Card(
          child: ListTile(
            leading: Icon(Icons.trending_down, color: Colors.red),
            title: Text('Expense'),
            subtitle: Text('Expense tracking will be added next'),
          ),
        ),
      ],
    );
  }

  Widget reports() {
    return const Center(
      child: Padding(
        padding: EdgeInsets.all(24),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Icon(Icons.bar_chart, size: 64, color: Color(0xFF1565C0)),
            SizedBox(height: 16),
            Text(
              'Business Reports',
              style: TextStyle(fontSize: 22, fontWeight: FontWeight.bold),
            ),
            SizedBox(height: 8),
            Text(
              'Income, expense and document reports '
              'will be connected to saved data.',
              textAlign: TextAlign.center,
            ),
          ],
        ),
      ),
    );
  }
}
